{
  "name": "abetapi",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3700",
    "build": "next build",
    "start": "next start -p 3700",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^11.6.0",
    "next": "16.4.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
