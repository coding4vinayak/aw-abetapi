# AbetAPI - Developer platform
# Prisma 7 resolves this relative to the project root (v6 resolved it against
# the schema directory); ./prisma/dev.db keeps the file v6 created.
DATABASE_URL="file:./prisma/dev.db"
PRODUCT_NAME=AbetAPI
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3700

# Email delivery for verification + password reset. Unset, links are written to
# the server log and the UI says so instead of claiming a message was sent.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Abetworks <noreply@yourdomain.com>
